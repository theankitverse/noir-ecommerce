# NOIR backend configuration
# Copy this file to `.env` and fill in your keys.

PORT=4000

# ----- Payment gateway priority: Razorpay (India) > Stripe > demo -----
# The store uses Razorpay automatically when RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET
# are set. If they are missing but Stripe keys are set, it falls back to Stripe.
# If both are missing it runs in DEMO mode.

# Razorpay keys (https://dashboard.razorpay.com/app/keys) — recommended for India.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys)
# Used as a fallback gateway when Razorpay keys are not set.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin panel password (http://localhost:4000/admin.html)
# MUST be set to a strong password. If unset, admin panel access will be disabled.
ADMIN_PASSWORD=

# Public URL of the site (used for gateway redirect URLs).
# Set to your deployed domain when going live.
BASE_URL=http://localhost:4000
